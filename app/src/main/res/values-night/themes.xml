<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Lector" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/lector_primary_light</item>
        <item name="colorPrimaryVariant">@color/lector_primary</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/lector_secondary</item>
        <item name="colorSecondaryVariant">@color/lector_secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        
        <!-- Error color -->
        <item name="colorError">@color/recording</item>
        <item name="colorOnError">@color/white</item>
    </style>
</resources>