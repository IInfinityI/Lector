<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/LectureListFragment">

    <fragment
        android:id="@+id/LectureListFragment"
        android:name="com.example.lector.LectureListFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_lecture_list">

        <action
            android:id="@+id/action_LectureListFragment_to_RecordingFragment"
            app:destination="@id/RecordingFragment" />
        
        <action
            android:id="@+id/action_LectureListFragment_to_EditorFragment"
            app:destination="@id/EditorFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/RecordingFragment"
        android:name="com.example.lector.RecordingFragment"
        android:label="@string/recording_title"
        tools:layout="@layout/fragment_recording">

        <action
            android:id="@+id/action_RecordingFragment_to_LectureListFragment"
            app:destination="@id/LectureListFragment"
            app:popUpTo="@id/LectureListFragment"
            app:popUpToInclusive="true" />
    </fragment>
    
    <fragment
        android:id="@+id/EditorFragment"
        android:name="com.example.lector.EditorFragment"
        android:label="Просмотр лекции"
        tools:layout="@layout/fragment_editor">

        <action
            android:id="@+id/action_EditorFragment_to_LectureListFragment"
            app:destination="@id/LectureListFragment"
            app:popUpTo="@id/LectureListFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>