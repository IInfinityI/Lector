<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Lector" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/lector_primary</item>
        <item name="colorPrimaryVariant">@color/lector_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/lector_secondary</item>
        <item name="colorSecondaryVariant">@color/lector_secondary_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/lector_background</item>
        <item name="colorSurface">@color/lector_surface</item>
        <item name="colorOnSurface">@color/lector_text_primary</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/lector_primary_dark</item>
        <item name="android:navigationBarColor">@color/lector_surface</item>
        
        <!-- Error color -->
        <item name="colorError">@color/recording</item>
        <item name="colorOnError">@color/white</item>
    </style>
    
    <style name="Theme.Lector" parent="Base.Theme.Lector" />
    
    <!-- Splash Screen Theme -->
    <style name="Theme.Lector.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/lector_primary_dark</item>
        <item name="android:navigationBarColor">@color/lector_surface</item>
    </style>
    
    <!-- Recording Button Style -->
    <style name="Widget.Lector.Button.Recording" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/recording</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
    </style>
    
    <!-- Content Block Card Style -->
    <style name="Widget.Lector.Card.ContentBlock" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/lector_card_background</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>
    
    <!-- FAB Style -->
    <style name="Widget.Lector.FAB.Primary" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/lector_primary</item>
        <item name="tint">@color/white</item>
        <item name="elevation">6dp</item>
    </style>
    
    <!-- Bottom Sheet Style -->
    <style name="Widget.Lector.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/lector_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Lector.BottomSheet</item>
    </style>
    
    <style name="ShapeAppearance.Lector.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
    <!-- Text Styles -->
    <style name="TextAppearance.Lector.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/lector_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    
    <style name="TextAppearance.Lector.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/lector_text_secondary</item>
    </style>
    
    <style name="TextAppearance.Lector.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/lector_text_hint</item>
    </style>
    
    <!-- Speaker Badge Style -->
    <style name="Widget.Lector.Chip.Speaker" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/lector_primary_light</item>
        <item name="checkedIconEnabled">false</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
    </style>
</resources>