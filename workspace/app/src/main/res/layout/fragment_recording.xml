<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lector_background">

    <!-- Верхняя панель с предметом и статусом -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lector_surface"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Дата начала лекции (ставится автоматически, фиксируется при старте) -->
            <TextView
                android:id="@+id/text_lecture_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/lector_primary"
                tools:text="📅 сегодня, суббота, 10.10.2026" />

            <!-- Поле предмета -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:endIconMode="dropdown_menu"
                android:hint="@string/recording_subject_hint">

                <AutoCompleteTextView
                    android:id="@+id/edit_subject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:completionThreshold="0"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Статус записи -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/recording_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/shape_recording_dot" />

                <TextView
                    android:id="@+id/recording_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp"
                    android:textColor="@color/recording"
                    android:textStyle="bold"
                    android:text="@string/status_ready" />

                <TextView
                    android:id="@+id/text_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="@color/lector_text_primary"
                    android:textStyle="bold"
                    android:text="00:00:00" />
            </LinearLayout>

            <!-- Текущий спикер -->
            <TextView
                android:id="@+id/current_speaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textColor="@color/lector_text_secondary"
                android:text="@string/speaker_auto_detect" />

            <!-- Транскрибация -->
            <TextView
                android:id="@+id/transcription_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="@color/lector_text_hint"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Живая лента записи в реальном времени (подтверждённые строки + печатающийся текст) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/live_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/lector_background"
        android:fillViewport="true"
        android:paddingTop="120dp"
        android:paddingBottom="170dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <TextView
            android:id="@+id/tv_live_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:textSize="18sp"
            android:lineSpacingExtra="6dp"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textColor="@color/lector_text_primary"
            android:text="" />

    </androidx.core.widget.NestedScrollView>

    <!-- Структурированный список блоков (виден после остановки записи) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingTop="140dp"
        android:paddingBottom="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Панель управления -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/lector_surface"
        android:elevation="8dp">

        <!-- Кнопки действий -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_math"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/block_math"
                app:icon="@drawable/ic_math"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_table"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/block_table"
                app:icon="@drawable/ic_table"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_photo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/block_image"
                app:icon="@drawable/ic_camera"
                app:iconGravity="textStart" />

        </LinearLayout>

        <!-- Основные кнопки управления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_stop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:layout_marginEnd="8dp"
                android:text="@string/recording_start"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause_resume"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/recording_pause"
                app:icon="@android:drawable/ic_media_pause"
                app:iconGravity="textStart"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="@string/recording_stop"
                app:icon="@android:drawable/ic_menu_save"
                app:iconGravity="textStart"
                app:cornerRadius="28dp"
                app:strokeColor="@color/lector_primary" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
